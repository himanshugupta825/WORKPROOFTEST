<?xml version="1.0" encoding="UTF-8"?>
<!--
  WorkProof deployment descriptor (Servlet 4.0 / Tomcat 9).

  What is declared here and why:
    - filters, in a deliberate order (encoding -> security headers -> authentication -> CSRF),
    - the session timeout,
    - the welcome file (the public landing page),
    - the error pages, which never show a stack trace to the visitor.

  The servlets themselves are declared with @WebServlet annotations in the
  controller package, which keeps each URL next to its Java class.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>WorkProof - Work Management and Proof-of-Work Verification System</display-name>

    <!-- =====================================================================
         1. FILTERS  (order of the filter-mapping elements defines the chain)
         ===================================================================== -->

    <!-- UTF-8 for every request and response - must be first. -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.workproof.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Browser security headers on every response. -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.workproof.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Session-based authentication. Public URLs are listed inside the class. -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.workproof.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- CSRF token check for every POST. Runs after authentication so a session exists. -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.workproof.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- =====================================================================
         2. SESSION
         ===================================================================== -->
    <session-config>
        <!-- 30 minutes; override with workproof.session.timeoutMinutes. -->
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Set to true when the app is served over HTTPS (not for localhost demos). -->
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- =====================================================================
         3. START-UP LISTENER (database check, upload folder, deadline job)
         ===================================================================== -->
    <listener>
        <listener-class>com.workproof.listener.AppContextListener</listener-class>
    </listener>

    <!-- =====================================================================
         4. WELCOME FILE  (public landing page)
         ===================================================================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- =====================================================================
         5. ERROR PAGES
            Every error is rendered by ErrorServlet/ErrorJSP with a friendly
            message. Stack traces stay in the Tomcat log.
         ===================================================================== -->
    <error-page>
        <error-code>403</error-code>
        <location>/access-denied</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error?code=404</location>
    </error-page>
    <error-page>
        <error-code>400</error-code>
        <location>/error?code=400</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error?code=500</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error?code=500</location>
    </error-page>

    <!-- =====================================================================
         6. JSP SETTINGS
         ===================================================================== -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

</web-app>
