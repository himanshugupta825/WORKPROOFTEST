{
  "// WorkProof": "Ctrl+Shift+P -> Tasks: Run Task  (see docs/VSCODE-SETUP.md)",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mvn test (unit tests)",
      "type": "shell",
      "command": "mvn test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "mvn package (build WAR)",
      "type": "shell",
      "command": "mvn clean package",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "deploy to Tomcat",
      "type": "shell",
      "command": "mvn clean package && cp target/WorkProof.war $CATALINA_HOME/webapps/ && $CATALINA_HOME/bin/shutdown.sh; sleep 3; $CATALINA_HOME/bin/startup.sh",
      "problemMatcher": []
    },
    {
      "label": "smoke suite (pages, roles, CSRF)",
      "type": "shell",
      "command": "bash docs/tools/smoke.sh",
      "problemMatcher": []
    },
    {
      "label": "flow suite (write workflow)",
      "type": "shell",
      "command": "bash docs/tools/flow.sh",
      "problemMatcher": []
    }
  ]
}
