src/main/resources/workproof-local.properties
config/
workproof.properties.local
*.secret
*.pem
*.key

# ---- Uploaded user evidence files (never in Git) ----
uploads/
workproof-uploads/

# ---- OS noise ----
.DS_Store
Thumbs.db
*.log
logs/


# Environment secrets
.env
.env.*
!.env.example

# Local configuration and credentials
config-local.properties
application-local.properties